{
  "version": 3,
  "configurePresets": [
    {
      "name": "base-global",
      "hidden": true,
      "description": "Root configuration for all compatible systems",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base-global",
      "description": "Base config for Linux systems",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "linux-base",
      "displayName": "Linux (General / Debug)",
      "description": "Linux profile oriented to general purposes and debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-g -O0"
      }
    },
    {
      "name": "linux-ultra-opt",
      "inherits": "linux-base",
      "displayName": "Linux Highly Optimized",
      "description": "Linux build profile with agressive optimization",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_CXX_FLAGS": "-O3 -march=native" 
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base-global",
      "description": "Base config for Windows systems",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_C_COMPILER": "cl"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base",
      "displayName": "Windows (General / Debug)",
      "description": "Windows profile oriented to general purposes and debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "/Zi /Od"
      }
    },
    {
      "name": "windows-ultra-opt",
      "inherits": "windows-base",
      "displayName": "Windows Highly Optimized",
      "description": "Windows build profile with agressive optimization",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_CXX_FLAGS": "/O2 /GL" 
      }
    }
  ],
  "buildPresets": [
    { "name": "build-linux-debug", "configurePreset": "linux-debug", "displayName": "Build Linux Debug" },
    { "name": "build-linux-opt", "configurePreset": "linux-ultra-opt", "displayName": "Build Linux Opt" },
    { "name": "build-windows-debug", "configurePreset": "windows-debug", "displayName": "Build Windows Debug" },
    { "name": "build-windows-opt", "configurePreset": "windows-ultra-opt", "displayName": "Build Windows Opt" }
  ]
}
